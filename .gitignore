# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Project working folders (not deployed)
/_raw-images/
/scratch-sheets/
mikasa-blueprint.md

# Design-skill session output (critiques, live-annotation sessions, question
# logs). Regenerated per run and specific to one machine, so it is working
# state rather than project history. The durable design record is docs/.
/.impeccable/

# Local Claude settings (personal)
.claude/settings.local.json

# Third-party skills cloned in for local use. ui-ux-pro-max-skill is a 24MB
# GitHub checkout that carries its own nested .git, which git cannot commit as
# ordinary files — it would land as a broken gitlink. Personal tooling, not
# project source.
.claude/skills/
